PORT=3000
NODE_ENV=development

# --- Local Postgres (docker-compose uses port 5433) ---
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=retunra

# --- Neon (production) ---
# From Neon: Project → Connect → copy the pooled connection string.
# Example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=

# --- Local Redis (docker-compose) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Upstash (production — use REST credentials from Upstash dashboard) ---
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
#
# Optional TCP fallback (local testing against Upstash only):
# UPSTASH_REDIS_URL=rediss://default:token@host:6379

# --- Cloudinary (image uploads) ---
# From Cloudinary dashboard: Settings → Access Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

# --- Google OAuth ---
# From Google Cloud Console: APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match an authorised redirect URI in Google Cloud Console
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- Facebook OAuth ---
# From Meta for Developers: App → App Settings → Basic
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
# Must match a valid OAuth redirect URI in Meta App Dashboard
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback

# --- Frontend ---
# Where to redirect after a successful OAuth login (tokens appended as query params)
FRONTEND_URL=http://localhost:3001

# Migrations (TypeORM)
# npm run db:migrate:dev          # apply pending migrations (dev, no build)
# npm run db:migrate              # build + apply migrations locally
# npm run db:migrate:prod         # apply after build (used on Render)
# npm run db:migrate:revert       # revert the last migration
# Add new migrations manually under src/database/migrations/
